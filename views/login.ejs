<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Online Shop</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #e3f2fd;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }
        .login-card {
            background: white;
            padding: 35px 30px;
            border-radius: 12px;
            width: 380px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            text-align: center;
        }
        h2 {
            color: #007bff;
            margin-top: 0;
            margin-bottom: 20px;
        }
        .form-group {
            text-align: left;
            margin-bottom: 15px;
        }
        label {
            font-weight: bold;
            color: #333;
            font-size: 14px;
            display: block;
            margin-bottom: 6px;
        }
        input {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
            font-size: 14px;
        }
        input:focus {
            outline: none;
            border-color: #007bff;
        }
        .btn-submit {
            width: 100%;
            background-color: #007bff;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            font-size: 15px;
            transition: background-color 0.2s;
        }
        .btn-submit:hover {
            background-color: #0056b3;
        }
        .error-msg {
            color: #dc3545;
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 15px;
            font-size: 14px;
        }
        .demo-accounts {
            margin-top: 25px;
            padding-top: 15px;
            border-top: 1px dashed #ccc;
            text-align: left;
            font-size: 12px;
            color: #666;
            background-color: #f9fbfd;
            padding: 12px;
            border-radius: 6px;
        }
        .demo-accounts b {
            color: #007bff;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h2>Shop Login</h2>

        <% if (errorMessage) { %>
            <div class="error-msg"><%= errorMessage %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" placeholder="Nhập username" required>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Nhập password" required>
            </div>
            <button type="submit" class="btn-submit">Đăng Nhập</button>
        </form>

        <div class="demo-accounts">
            <strong>Tài khoản dùng thử có sẵn:</strong><br>
            • Admin (toàn quyền): <b>admin</b> / <b>admin123</b><br>
            • User (chỉ xem & tạo): <b>user</b> / <b>user123</b>
        </div>
    </div>
</body>
</html>
